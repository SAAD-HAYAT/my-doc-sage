OPENROUTER_API_KEY=
# Optional: a second OpenRouter account's key. Free-tier quota is per-key,
# so once OPENROUTER_API_KEY starts returning 429s, lib/openrouter.ts
# automatically switches to this one for the rest of the process.
OPENROUTER_API_KEY_2=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 7 (auth): same project, but the browser-safe key -- check
# Supabase dashboard > Project Settings > API. Newer projects show a
# "publishable key" (sb_publishable_...); older ones show a JWT-style
# "anon key" instead. Whichever your dashboard actually shows, paste it
# here -- @supabase/ssr's browser/server clients accept either.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only needed to run `npm run eval` (scripts/eval.ts) -- the auth.users
# UUID that owns the documents tests/fixtures/eval-set.json is grounded
# in. Find it via Supabase dashboard > Authentication > Users after
# signing in once.
EVAL_USER_ID=
